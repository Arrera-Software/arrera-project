# --- Paramètres Django ---
# DEBUG : 0 en production (défaut sûr), 1 uniquement en développement local.
DEBUG=0
# SECRET_KEY : OBLIGATOIRE en production. Générer une valeur aléatoire >= 50 caractères, ex :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Hôtes autorisés (séparés par des virgules). Valeur explicite requise en production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance CSRF (schéma + hôte + port).
CSRF_TRUSTED_ORIGINS=https://votre-domaine.example

# --- Clé de chiffrement du coffre-fort (Fernet, 44 caractères base64) ---
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Ports ---
WEB_PORT=8020
DB_PORT=5432

# --- Base de données PostgreSQL ---
DB_NAME=arrera_db
DB_USER=arrera_user
# DB_PASSWORD : OBLIGATOIRE en production. Utiliser un mot de passe fort et unique.
DB_PASSWORD=
DB_HOST=db

# --- Anti-brute-force ---
AXES_FAILURE_LIMIT=5

# --- Superutilisateur Django initial ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
